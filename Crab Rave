local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local HttpService       = game:GetService("HttpService")
local RunService        = game:GetService("RunService")
local TweenService      = game:GetService("TweenService")
local Players           = game:GetService("Players")

local ClientEventUtils = require(ReplicatedStorage.Controllers.EventController.ClientEventUtils)
local SoundController  = require(ReplicatedStorage.Controllers.SoundController)
local CameraController = require(ReplicatedStorage.Controllers.CameraController)
local Observers        = require(ReplicatedStorage.Packages.Observers)
local Trove            = require(ReplicatedStorage.Packages.Trove)

local script_ref = ReplicatedStorage.Controllers.EventController.Events["Crab Rave"]
local LocalPlayer = Players.LocalPlayer

repeat task.wait() until ReplicatedStorage:GetAttribute("CrabRave")

local startedAt = ReplicatedStorage:GetAttribute("CrabRaveStartTimestamp")
    or workspace:GetServerTimeNow()

local function timeLeft(t) return startedAt + t - workspace:GetServerTimeNow() end

local running = true
local trove   = Trove.new()

-- ── ocean / color correction ───────────────────────────────────────────────
local cc = trove:Add(Instance.new("ColorCorrectionEffect"))
cc.Parent = workspace.CurrentCamera

TweenService:Create(cc, TweenInfo.new(timeLeft(1.95)), { Brightness = -1.2 }):Play()

local ocean = trove:Clone(script_ref.Ocean)
ocean.Parent = workspace

local oceanPart      = ocean:FindFirstChild("ocean")
local att1           = ocean:FindFirstChild("att1")
local oceanparticles = ocean:FindFirstChild("oceanparticles")

for _, beam in ocean:GetChildren() do
    if beam:IsA("Beam") then
        local orig = beam.TextureLength
        beam.TextureLength = 0
        if oceanPart then
            TweenService:Create(oceanPart,
                TweenInfo.new(timeLeft(45), Enum.EasingStyle.Quint, Enum.EasingDirection.In),
                { TextureLength = orig }):Play()
        end
    end
end

if att1 then
    TweenService:Create(att1,
        TweenInfo.new(timeLeft(45), Enum.EasingStyle.Quint, Enum.EasingDirection.In),
        { Position = Vector3.new(0, 0, 400) }):Play()
end

if oceanparticles then
    trove:Add(task.delay(timeLeft(45), function()
        local VFX = require(ReplicatedStorage.Shared.VFX)
        VFX.enable(oceanparticles)
    end))
end

-- highlight flash driven by loudness
local highlight = trove:Add(Instance.new("Highlight"))
highlight.DepthMode          = Enum.HighlightDepthMode.Occluded
highlight.FillColor          = Color3.new(1, 1, 1)
highlight.FillTransparency   = 1
highlight.OutlineTransparency = 1

-- wire highlight to crab folder once it appears
trove:Add(Observers.observeTag("CrabRaveCrabFolder", function(folder)
    highlight.Parent = folder
end))

trove:Add(task.delay(timeLeft(7), function()
    if highlight then highlight:Destroy(); highlight = nil end
    TweenService:Create(cc, TweenInfo.new(1), { Brightness = 0 }):Play()
end))

-- loudness → FOV + highlight flash
local flashCd  = 0
local fovCd    = 0
local CrabRave = workspace.Sounds.CrabRave

trove:Add(RunService.PostSimulation:Connect(function(dt)
    flashCd = flashCd - dt
    fovCd   = fovCd   - dt

    local loud = math.clamp((CrabRave.PlaybackLoudness - 100) / 900, 0, 1)

    if flashCd <= 0 and highlight then
        flashCd = 0.5
        highlight.FillTransparency = 0
        TweenService:Create(highlight, TweenInfo.new(0.3), { FillTransparency = 1 }):Play()
    end

    if loud >= 0.25 and fovCd <= 0 then
        fovCd = 0.1
        CameraController:Fov((loud - 0.25) * 20 + 70, 0.1)
    end
end))

-- sync music
task.spawn(function()
    while not CrabRave.IsLoaded do task.wait() end
    CrabRave.TimePosition = math.max(CrabRave.TimePosition, workspace:GetServerTimeNow() - startedAt)
end)

-- ── crab visuals — observeTag mirrors the decompiled client exactly ─────────
trove:Add(Observers.observeTag("CrabRaveCrabs", function(crab)
    local ct = Trove.new()
    local crabType = crab.Parent and crab.Parent.Name or "Ground"

    local model = ct:Clone(script_ref.Crab)
    model["Cylinder.005"].Transparency = 1
    ct:Add(task.delay(timeLeft(2), function()
        if model["Cylinder.005"] then model["Cylinder.005"].Transparency = 0 end
    end))

    local weld = ct:Add(Instance.new("Weld"))
    weld.Part0  = model["Cylinder.005"]
    weld.Part1  = crab.HumanoidRootPart
    weld.C1     = CFrame.new(0, 3.6, 0)
    weld.Parent = model
    model.Parent = crab

    local anim   = model.AnimationController
    local rot    = 0
    local rotTarget = 0
    local C1base = CFrame.new(0, 3.6, 0)

    ct:Add(RunService.PostSimulation:Connect(function(dt)
        if math.abs(rotTarget - rot) >= 0.1 then
            rot = rotTarget + (rot - rotTarget) * math.exp(dt * -1)
            weld.C1 = C1base * CFrame.Angles(0, rot, 0)
        end
    end))

    local function loadAnim(ref)
        local a = anim:LoadAnimation(ref)
        ct:Add(function() a:Stop(0); a:Destroy() end)
        return a
    end

    local anim1  = loadAnim(script_ref.Animation1)
    local anim2  = loadAnim(script_ref.Animation2)
    local anim3R = loadAnim(script_ref.Animation3_Right)
    local anim3L = loadAnim(script_ref.Animation3_Left)
    local anim4W = loadAnim(script_ref.Animation4_Walk)
    local anim4A = loadAnim(script_ref.Animation4_Attack)
    local anim5  = loadAnim(script_ref.Animation5)
    local anim6  = loadAnim(script_ref.Animation6)
    local anim7  = loadAnim(script_ref.Animation7)
    local anim8  = loadAnim(script_ref.Animation8)

    anim3L.Priority = Enum.AnimationPriority.Action
    anim3R.Priority = Enum.AnimationPriority.Action
    anim4W.Priority = Enum.AnimationPriority.Action
    anim4A.Priority = Enum.AnimationPriority.Action4
    for _, a in { anim5, anim6, anim7, anim8 } do
        a.Priority = Enum.AnimationPriority.Action2
    end

    local danceAnims = { anim5, anim6, anim7, anim8 }
    local walkAnim   = anim4W
    local currentDance = nil

    anim1:Play()

    ct:Add(task.delay(timeLeft(7), function()
        anim1:Stop(); anim2:Play()
    end))

    -- IsRunning → walk anim
    ct:Add(crab:GetAttributeChangedSignal("IsRunning"):Connect(function()
        if crab:GetAttribute("IsRunning") then
            if not walkAnim.IsPlaying then walkAnim:Play() end
        else
            if walkAnim.IsPlaying then walkAnim:Stop() end
        end
    end))

    -- Attack
    ct:Add(crab:GetAttributeChangedSignal("Attack"):Connect(function()
        anim4A:Play()
    end))

    -- Dance
    ct:Add(crab:GetAttributeChangedSignal("Dance"):Connect(function()
        local idx = crab:GetAttribute("Dance")
        -- during 85-105s window force dance 4
        local elapsed = workspace:GetServerTimeNow() - startedAt
        if elapsed >= 85 and elapsed < 105 then idx = 4 end

        if currentDance and (not idx or danceAnims[idx] == currentDance) then return end
        if currentDance then currentDance:Stop(); currentDance = nil end
        if idx and danceAnims[idx] then
            currentDance = danceAnims[idx]
            currentDance:Play()
        end
    end))

    -- wall crab: switch back to anim1 at t=31 and t=46
    if crabType == "Wall" then
        ct:Add(task.delay(timeLeft(31), function() anim2:Stop(); anim1:Play() end))
        ct:Add(task.delay(timeLeft(46), function() anim2:Stop(); anim1:Play() end))
    end

    -- sideways shuffle at t=27.5
    ct:Add(task.delay(timeLeft(27.5), function()
        if crabType ~= "Ground" then return end
        anim3L:Play(nil, nil, 1/3)
        rotTarget = math.pi / 2
    end))

    -- face forward at t=43
    ct:Add(task.delay(timeLeft(43), function()
        anim3R:Play(nil, nil, 1/3)
        rotTarget = 0
    end))

    ct:Add(task.delay(timeLeft(46), function()
        anim3R:Stop()
        if not walkAnim.IsPlaying and crab:GetAttribute("IsRunning") then walkAnim:Play() end
    end))

    -- slow dance speed 141-161
    ct:Add(task.delay(timeLeft(141), function()
        local elapsed2 = 0
        local total    = timeLeft(161)
        ct:Add(RunService.PreSimulation:Connect(function(dt)
            elapsed2 += dt
            local speed = math.lerp(1, 0.1, elapsed2 / total)
            for _, a in danceAnims do a:AdjustSpeed(speed) end
        end))
    end))

    -- ground crab sanddrum at ReachedFirstTarget
    local sandroll
    if crabType == "Ground" then
        ct:Add(crab:GetAttributeChangedSignal("ReachedFirstTarget"):Once(function()
            sandroll = ct:Clone(script_ref.SanddrumRoll)
            local sw = ct:Add(Instance.new("Weld"))
            sw.Part0 = sandroll
            sw.Part1 = model["Cylinder.005"]
            sw.C0    = CFrame.new(0.2, 3.629, 4.378)
            sw.Parent = sandroll
            sandroll.Parent = model
        end))

        ct:Add(task.delay(timeLeft(27.5), function()
            if sandroll then
                sandroll.ParticleEmitter.Enabled = false
                task.delay(3, function() ct:Remove(sandroll) end)
                sandroll = nil
            end
        end))
    end

    return ct:WrapClean()
end))

-- ── player dance at t=46 ───────────────────────────────────────────────────
trove:Add(task.delay(timeLeft(46), function()
    local obs = Observers.observeCharacter(LocalPlayer, function(_, char)
        local ct2 = Trove.new()
        ct2:Add(task.spawn(function()
            local hum = char:WaitForChild("Humanoid")
            if not hum then return end
            local animator = hum:WaitForChild("Animator")
            if not animator then return end

            local dance = animator:LoadAnimation(script_ref.Dance)
            dance.Priority = Enum.AnimationPriority.Action
            dance:Play(2)

            local idle = 0
            local lastLen = 0

            ct2:Add(RunService.PostSimulation:Connect(function(dt)
                local now = workspace:GetServerTimeNow()
                local elapsed = now - startedAt

                if elapsed < 66 then
                    if not dance.IsPlaying then
                        dance:Play()
                        dance.TimePosition = elapsed % dance.Length
                    end
                else
                    if dance.Length ~= lastLen and dance.Length > 0 then
                        lastLen = dance.Length
                        dance.TimePosition = elapsed % dance.Length
                    end
                    local moving = hum.MoveDirection ~= Vector3.zero
                        or LocalPlayer:GetAttribute("Stealing")

                    if moving then
                        idle = 0
                        if dance.IsPlaying then dance:Stop() end
                    else
                        idle = idle + dt
                        if idle >= 3 and not dance.IsPlaying then
                            dance:Play()
                            dance.TimePosition = elapsed % dance.Length
                        end
                    end
                end
            end))

            ct2:Add(function() dance:Stop(); dance:Destroy() end)
        end))
        return ct2:WrapClean()
    end)

    -- auto-disconnect at t=140
    trove:Add(task.delay(timeLeft(140), obs))
    trove:Add(obs)
end))

-- ── crab hit burst (no remote — observe the trait being applied) ───────────
trove:Add(CollectionService:GetInstanceAddedSignal("Animal"):Connect(function() end))
-- watch for Claws trait being added client-side to trigger burst vfx
trove:Add(RunService.Heartbeat:Connect(function()
    for _, animal in ipairs(CollectionService:GetTagged("Animal")) do
        if animal:GetAttribute("_clawsBurst") then continue end
        local json = animal:GetAttribute("Traits")
        if not json then continue end
        local ok, t = pcall(HttpService.JSONDecode, HttpService, json)
        if not ok or type(t) ~= "table" then continue end
        for _, v in ipairs(t) do
            if v == "Claws" then
                animal:SetAttribute("_clawsBurst", true)
                ClientEventUtils.playBurst(script_ref.CrabHit, animal.Name)
                SoundController:PlaySound(
                    ReplicatedStorage.Sounds.Events["Crab Rave"].Hit,
                    animal.PrimaryPart and animal.PrimaryPart.Position
                )
                break
            end
        end
    end
end))

-- ── cleanup ────────────────────────────────────────────────────────────────
task.spawn(function()
    while ReplicatedStorage:GetAttribute("CrabRave") do task.wait(1) end
    running = false
    trove:Destroy()
    ocean:Destroy()
end)
